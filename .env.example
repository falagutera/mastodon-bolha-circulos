# Your instance. Only its accounts can draw a circle.
CIRCLES_INSTANCE=https://example.social

# Where this app is served, always https.
CIRCLES_BASE_URL=https://circles.example.social

# OAuth application, see README.md.
CIRCLES_CLIENT_ID=
CIRCLES_CLIENT_SECRET=

# Signs the session cookie: openssl rand -hex 32
CIRCLES_SECRET=

# Read-only database user, see README.md.
CIRCLES_DB_HOST=10.0.0.10
CIRCLES_DB_USER=circles
CIRCLES_DB_PASSWORD=change-me

# Optional, defaults shown.
#CIRCLES_DB_PORT=5432
#CIRCLES_DB_NAME=mastodon_production
#CIRCLES_DB_SSLMODE=prefer
#CIRCLES_LANG=en
#CIRCLES_CACHE_TTL=1h
